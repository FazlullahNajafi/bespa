# Copy to .env and fill in from your Supabase project settings (API section).
# EXPO_PUBLIC_* is inlined into the JS bundle at build time and is therefore PUBLIC.
# The anon key is designed for that; the service_role key must NEVER appear here or
# anywhere in the app bundle (spec 02.4).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Either the legacy `anon` JWT or the newer `sb_publishable_...` key — same privileges,
# same variable. NEVER the `sb_secret_...` / service_role key: it bypasses all RLS.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Local stack (npm run db:start) prints these; url is http://127.0.0.1:54321

# Sentry. The DSN is NOT a secret — it ships inside the app and only permits writing
# events. Leave it empty and crash reporting is a no-op (src/lib/sentry.ts).
EXPO_PUBLIC_SENTRY_DSN=

# Source-map upload at build time only; never enters the bundle. SENTRY_AUTH_TOKEN is a
# secret and belongs in .env.local here, and in an EAS environment variable with
# "sensitive" visibility for builds. Org and project gate the config plugin in app.config.
SENTRY_ORG=
SENTRY_PROJECT=
# Uncomment to force Sentry on in a dev build, with the SDK's own verbose logging.
# EXPO_PUBLIC_SENTRY_DEBUG=1
